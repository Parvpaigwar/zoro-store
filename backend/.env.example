PORT=5000
# Leave empty in development to use an in-memory MongoDB (auto-seeded).
# Set to a real MongoDB / Atlas URI for persistent data.
MONGO_URI=
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# --- Admin auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Super admin is created on startup if none exists. Change the password after first login.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@zoro.store
ADMIN_PASSWORD=change-me
